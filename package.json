    "preview": "vite preview",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "bitecs": "^0.4.0"
  }
}
