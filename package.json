{
  "name": "invaders",
  "version": "0.0.1",
  "description": "Reimplementation of the Taito classic just for fun. This time using HTML5 canvas.",
  "homepage": "https://github.com/phonaputer/invaders-ts#readme",
  "bugs": {
    "url": "https://github.com/phonaputer/invaders-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phonaputer/invaders-ts.git"
  },
  "author": "phonaputer",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "lint": "tsc --noemit && oxlint",
    "lint:fix": "oxlint --fix",
